<html>

<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1" name="viewport" />

    <link rel="icon" type="image/png" href="/home/graphics/favicon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Noto+Sans+Mono:wght@300&family=Noto+Serif:ital,wght@0,100..900;1,100..900&display=swap">

    <title>You don't need to guess</title>
    <style>
        * {
            font-family: 'Noto Sans Mono', sans-serif;
            font-weight: 400;
            letter-spacing: 1px;
            margin: 0;
        }

        body {
            background-color: #333;
            color: #4efc03;
            margin: 0;
            display: flex;
            flex-flow: column nowrap;
            align-items: center;
            height: 100vh;
            width: 100vw;
        }

        #com-break {
            position: fixed;
            width: 100vw;
            height: 100vh;
            background: rgba(0,0,0,0.8);
            z-index: 2;
            justify-content: flex-start;
            display: none;
        }

        #com-break p {
            width: 500px;
            margin: 5vh 0;
        }

        .row {
            display: flex;
            flex-flow: row nowrap;
        }

        .column {
            display: flex;
            flex-flow: column nowrap;
        }

        .center {
            align-items: center;
            justify-content: center;
            text-align: center;
            vertical-align: middle;
        }

        .noselect {
            -webkit-touch-callout: none;
            -webkit-user-select: none;
            -khtml-user-select: none;
            -moz-user-select: none;
            -ms-user-select: none;
            user-select: none;
        }

        .mode-picker {
            display: none;
            
            margin-top: 2.5vh;
            border: 1px solid #4efc03;
            border-radius: 2px;
            background-color: #333;
            color: #4efc03;
            padding: 3px 5px;
        }

        #victory {
            display: none;
            margin: 2.5vw 0;
            border: 1px dotted #ff59ba; 
            color: #ff59ba;
        }

        #guesses {
            border: 1px dashed #4efc03;
            margin: 2.5vw 0;
            padding-bottom: 10px;
            padding-top: 5px;
        }

        #guesses.one-wrong {
            border-color: rgb(238, 223, 17);
        }
        #guesses.two-wrong {
            border-color: rgb(238, 109, 17);
        }
        #guesses.three-wrong {
            border-color: #e11;
        }

        #guesses .guess {
            font-weight: bold;
            font-size: 20px;
            margin: 0 8px;
        }

        #guesses .guess.blank {
            color: #333;
            border-bottom: 1px solid #4efc03;
        }

        #guesses .guess.x {
            color: #ee1111;
            border-bottom: 1px solid #e11;
        }

        #content .revealed {
            min-height: 10px;
        }

        #content .line {
            margin-bottom: 20px;
            justify-content: center;

            flex-wrap: wrap;
        }

        #content .tile {
            border: 1px solid #333;
        }

        #content .tile.highlighted, #content .tile:hover:not(.ptile) {
            border: 1px solid #999;
        }

        #content .letter {
            font-size: 16px;
            border-bottom: 1px solid #4efc03;
            margin: 0px 4px;
            padding: 0px 3px;
        }

        #content .letter.hidden {
            color: #333;
        }

        #content .code-number {
            font-size: 13px;
            color: green;
        }

        #content .punctuation {
            width: 20px;
            text-align: center;
        }

        .game {
            width: 90vw;
            padding: 0 5vw;
        }
        

        .tracker {
            display: none;

            width: 10vw;
        }

        #content {
            width: 90vw;
            /* width: 70vw; */
        }

        #tracker .row {
            padding-bottom: 2px;
        }

        #tracker .index {
            margin-right: 10px;
            width: 35px;
            text-align: right;
            padding-top: 1px;
        }

        #tracker .char {
            border-bottom: 1px solid #4efc03;
            padding: 0 3px;
        }

        #tracker .char.hidden {
            color: #333;
        }

        .new-game {
            display: none;

            margin-top: 2.5vh;
            font-size: 16px;
            border: 1px solid #4efc03;
            border-radius: 5px;
            padding: 15px;
            cursor: pointer;
        }

        .new-game:hover {
            background-color: #444;
        }

        #hidden-input {
            position: fixed;
            top: 0;
            width: 0;
            height: 0;
            z-index: -1;
            border: none;
            outline: none;
            padding: 0;
            margin: 0;
            background-color: #333;
            color: #333;
        }

        @media (max-width: 600px) {
            #content .tile:hover:not(.ptile):not(.highlighted) {
                border: 1px solid #333;
            }
        }
    </style>
</head>

<body 
    onload="
        document.querySelector('#content .row.line .column .hidden').parentElement.className += ' highlighted';
        let randomPercent = (Math.random()*50 + 55)
        if (randomPercent > 100) {
            randomPercent += Math.random()*69
        }
        randomPercent = Math.floor(randomPercent*100)/100;
        alert(`Only ${randomPercent}% of the players solved this level at the first try!`);
        refreshAd();
    "
    class="noselect"
>
    <script>
        function checkVictory () {
            const stillHidden = document.querySelector('#content .row.line .column .hidden');
            if (stillHidden === null) {
                // Game over!
                document.getElementById('guesses').style.display = 'none';
                document.getElementById('victory').style.display = 'flex';
            }
        }

        function refreshAd () {
            const r = Math.floor(Math.random()*75)+1;
            document.getElementById('com-img').src = `https://psychoca.de/decode/ads/${r}.jpg`
        }
        function runAd () {
            document.getElementById('com-break').style.display = 'flex';
        }

        window.addEventListener('keydown', (event) => {
            if (event.repeat) { return }
            const letter = event.key.toUpperCase();
            if (letter.match(/[A-Z]/gm).length != 1) {
                checkVictory();
                return;
            }

            const highlightedTile = document.querySelector('.highlighted');
            const highlightedLetter = highlightedTile.children[0];
            const encodedAs = parseInt(highlightedTile.children[1].innerText);

            if (highlightedLetter.classList.contains('hidden')) {
                if (letter == highlightedLetter.innerText) {
                    highlightedLetter.classList.toggle('hidden', false);
                    highlightedLetter.classList.toggle('revealed', false);

                    const allOfThisLetter = Array.from(document.querySelectorAll(`#content .encoded-as-${encodedAs}`));
                    let revealedAll = true;
                    for (const l of allOfThisLetter) {
                        if (l.classList.contains('hidden')) {
                            revealedAll = false;
                            break;
                        }
                    }
                    if (revealedAll) {
                        allOfThisLetter.map(e => e.nextElementSibling.innerText = ' ');
                    }

                    if (Math.random() < 0.01) {
                        runAd();
                    }
                } else {
                    // Don't want to allow you to guess a revealed letter
                    // TODO: don't let you guess a letter wrong if it's revealed somewhere else
                    const allRevealed = document.querySelectorAll('#tracker .char.revealed');
                    for (const r of allRevealed) {
                        if (r.innerHTML == letter) {
                            return;
                        }
                    }
                    let nextGuess = document.querySelector('.guess.blank');
                    if (nextGuess !== null) {
                        nextGuess.classList.toggle('blank', false);
                        nextGuess.classList.toggle('x', true);
                    }

                    const lives = document.querySelectorAll('.guess.blank').length;
                    const gecl = document.getElementById('guesses').classList;
                    if (lives == 2) {
                        gecl.toggle('one-wrong', true);
                    } else if (lives == 1) {
                        gecl.toggle('one-wrong', false);
                        gecl.toggle('two-wrong', true);
                    } else if (lives == 0) {
                        if (gecl.contains('three-wrong')) {
                            const gel = document.getElementById('guesses');
                            gel.append(gel.childNodes[0].cloneNode(true));
                            gel.insertBefore(gel.children[0].cloneNode(true), gel.children[0]);
                        } else {
                            gecl.toggle('two-wrong', false);
                            gecl.toggle('three-wrong', true);
                            alert("YOU DON'T NEED TO GUESS!!!");
                        }
                    }
                    
                    checkVictory();
                    return; // don't move cursor
                }
            }

            // move cursor to the next letter
            let nextTile = highlightedTile.nextElementSibling;

            let sanity = 1000;
            while ((nextTile === null || nextTile.classList.contains('ptile')) && sanity > 0) {
                if (nextTile === null) {
                    nextLine = highlightedTile.parentElement.nextElementSibling;
                    if (nextLine === null) {
                        // Loop back to the beginning
                        toHighlight = document.querySelector('#content .row.line .column .hidden');
                        if (toHighlight === null) {
                            checkVictory();
                            return;
                        } else {
                            nextTile = toHighlight;
                        }
                    } else {
                        nextTile = nextLine.children[0];
                    }
                } else {
                    nextTile = nextTile.nextElementSibling;
                }
                sanity -= 1;
            }
            nextTile.click();
            checkVictory();
        });
    </script>

    <div 
        id="com-break" 
        onclick="this.style.display='none'; refreshAd();"
        class="column center"
    >
        <p>Advertisement, click to skip in 5... 4... 3... 2... 1... ok you can exit out now</p>
       <img id="com-img" />
    </div>

    <select 
        id="sel" 
        class="mode-picker"
        onchange="location.search=`mode=${document.getElementById('sel').value}`"
    >
        <% for (let s=0; s < modes.length; s++) { %>
            <% if (modes[s]==selected) { %>
                <option value="<%= modes[s] %>" selected>
                    <%= modes[s] %>
                </option>
            <% } else { %>
                <option value="<%= modes[s] %>">
                    <%= modes[s] %>
                </option>
            <% } %>
        <% } %>
    </select>

    <div class="game column">
        <div id="victory" class="column center" onclick="window.location.reload()">
            <p>You Won!! I love you :) You're so smart and hot.</p>
            <p>If you wanna play again, just reload or click this text</p>
        </div>

        <div id="guesses" class="row center">
            <div class="guess blank">X</div>
            <div class="guess blank">X</div>
            <div class="guess blank">X</div>
        </div>

        <div class="row">
            <div class="tracker"></div>
            <div id="content">
                <% for (let l=0; l < text.length; l++) { %>
                    <div class="row line">
                        <% for (let w=0; w < text[l].length; w++) { %>
                            <span class="word row">
                                <% for (let c=0; c < text[l][w].length; c++) { %>
                                    <% if (text[l][w][c].match(/[A-Z]/)) { %>
                                        <span 
                                            class="column tile" 
                                            onclick="
                                                document.querySelector('.highlighted').classList.toggle('highlighted', false);
                                                this.classList.toggle('highlighted', true);
                                                document.getElementById('hidden-input').focus();
                                            "
                                        >
                                            <% if (encodedText[l][w][c] != -1) { %>
                                                <div
                                                    class="letter encoded-as-<%= encodedText[l][w][c] %> hidden"
                                                >
                                                    <%= text[l][w][c] %>
                                                </div>
                                                <div class="code-number center"><%= encodedText[l][w][c] %></div>
                                            <% } else { %>
                                                <div class="letter revealed"><%= text[l][w][c] %></div>
                                                <div class="code-number center"></div>
                                            <% } %>
                                        </span>
                                    <% } else { %>
                                        <span class="tile ptile">
                                            <div class="punctuation"><%= text[l][w][c] %></div>
                                        </span>
                                    <% } %>
                                <% } %>
                            </span>
                        <% } %>
                    </div>
                <% } %>
            </div>

            <div id="tracker" class="tracker">
                <% for (let c=0; c < encodingArr.length; c++) { %>
                    <span class="row">
                        <p class="index"><%= c %>:</p>
                        <% if (revealed.indexOf(encodingArr[c]) != -1) { %>
                            <p class="char encoded-as-<%= c %> revealed"><%= encodingArr[c] %></p>
                        <% } else { %>
                            <p class="char encoded-as-<%= c %> hidden"><%= encodingArr[c] %></p>
                        <% } %>
                    </span>
                <% } %>
            </div>
        </div>
    </div>

    <div class="new-game" onclick="">New Game</div>

    <input type="text" id="hidden-input">
</body>

</html>